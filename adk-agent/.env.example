# Mobivable ADK Agent Service — Environment Variables
#
# Required for Vertex AI (Gemini models):
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Required — MCP bridge to Node.js server:
MOBIVABLE_MCP_URL=https://mobivable-xxxxx.run.app/api/public/mcp
MCP_SERVICE_TOKEN=your-service-auth-token

# Optional — Model overrides:
ADK_FAST_MODEL=gemini-2.5-flash
ADK_STRONG_MODEL=gemini-2.5-pro

# Optional — Server config:
PORT=8081
LOG_LEVEL=INFO
