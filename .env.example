# Supabase (required)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Google AI — Gemini API key (for local development)
GOOGLE_AI_API_KEY=

# Vertex AI — Recommended for production (Google Cloud Agent Platform)
# When configured, Vertex AI becomes the primary LLM provider.
VERTEX_AI_SERVICE_ACCOUNT={"type":"service_account",...}
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# ADK Agent Service — Google Agent Development Kit orchestration
# When set, agent orchestration routes through the ADK microservice.
ADK_AGENT_URL=https://mobivable-adk-xxxxx.run.app

# PixLab AI Coder (optional — powers the Code Export panel)
# Get your API key at https://pixlab.io/
PIXLAB_API_KEY=

